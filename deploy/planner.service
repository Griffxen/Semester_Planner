[Unit]
Description=Semester planner
After=network.target
[Service]
User=planner
Group=planner
WorkingDirectory=/opt/semester-planner
Environment=PLANNER_DB=/var/lib/semester-planner/planner.db
Environment=PLANNER_SECURE=1
ExecStart=/usr/bin/python3 /opt/semester-planner/app.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/semester-planner
[Install]
WantedBy=multi-user.target
